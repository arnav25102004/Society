{
  "expo": {
    "name": "SocietyHub",
    "slug": "societyhub",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.societyhub.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture visitor photos at the gate.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to complaints."
      }
    },
    "android": {
      "package": "com.societyhub.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://10.40.0.130:3000/api/v1",
      "wsUrl": "ws://10.40.0.130:3000"
    }
  }
}
