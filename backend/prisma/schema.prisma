generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MemberRole {
  owner
  tenant
  committee
  guard
  admin
}

enum MemberStatus {
  pending
  approved
  rejected
}

enum ComplaintStatus {
  open
  assigned
  in_progress
  resolved
  closed
  escalated
}

enum ComplaintPriority {
  low
  medium
  high
  critical
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum BillStatus {
  unpaid
  paid
  partial
  overdue
}

enum VisitorStatus {
  pending
  approved
  rejected
  expired
  pre_approved
}

enum VisitorPurpose {
  delivery
  guest
  cab
  service
  other
}

enum AnnouncementCategory {
  general
  maintenance
  event
  emergency
  rule
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum ListingStatus {
  available
  reserved
  sold
}

enum ListingCategory {
  electronics
  furniture
  appliances
  clothing
  books
  vehicles
  sports
  kids
  other
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum SosStatus {
  active
  resolved
}

enum ConsentType {
  data_collection
  push_notifications
  photo_capture
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Society {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(200)
  address      String
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  pincode      String   @db.VarChar(10)
  totalFlats   Int
  societyCode  String   @unique @db.VarChar(10)
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members            SocietyMember[]
  complaints         Complaint[]
  bills              MaintenanceBill[]
  payments           Payment[]
  visitors           Visitor[]
  preApprovals       PreApproval[]
  announcements      Announcement[]
  marketplaceListings MarketplaceListing[]
  amenities          Amenity[]
  sosAlerts          SosAlert[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  knowledgeEntries   KnowledgeEntry[]
  agreements         Agreement[]

  @@map("societies")
}

model User {
  id             String   @id @default(uuid())
  phone          String   @unique @db.VarChar(500)
  name           String   @db.VarChar(200)
  email          String?  @db.VarChar(255)
  avatarUrl      String?
  expoPushToken  String?
  pinHash        String?  @db.VarChar(100) @map("pin_hash")
  isDeleted      Boolean  @default(false)  @map("is_deleted")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships           SocietyMember[]
  complaintsRaised      Complaint[]           @relation("ComplaintRaisedBy")
  complaintsAssigned    Complaint[]           @relation("ComplaintAssignedTo")
  payments              Payment[]
  visitorApprovals      Visitor[]             @relation("VisitorApprovedBy")
  visitorGuard          Visitor[]             @relation("VisitorGuard")
  preApprovals          PreApproval[]
  announcementsPosted   Announcement[]
  announcementReads     AnnouncementRead[]
  refreshTokens         RefreshToken[]
  refreshTokenFamilies  RefreshTokenFamily[]
  deviceSessions        DeviceSession[]
  consentRecords        ConsentRecord[]
  marketplaceListings   MarketplaceListing[]
  listingInterests      ListingInterest[]
  amenityBookings       AmenityBooking[]
  sosAlerts             SosAlert[]            @relation("SosRaisedBy")
  sosResponses          SosAlert[]            @relation("SosRespondedBy")
  expensesCreated       Expense[]
  knowledgeEntries      KnowledgeEntry[]
  agreements            Agreement[]

  @@map("users")
}

model SocietyMember {
  id         String       @id @default(uuid())
  userId     String
  societyId  String
  flatNumber String       @db.VarChar(500)
  role       MemberRole
  status     MemberStatus @default(pending)
  joinedAt   DateTime     @default(now())

  user    User    @relation(fields: [userId], references: [id])
  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, flatNumber, userId])
  @@index([societyId, status])
  @@map("society_members")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model RefreshTokenFamily {
  id        String   @id @default(uuid())
  familyId  String   @db.VarChar(50)
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token_families")
}

model LoginAttempt {
  id            String    @id @default(uuid())
  phone         String    @unique @db.VarChar(500)
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?

  @@map("login_attempts")
}

model DeviceSession {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String   @db.VarChar(200)
  deviceName String?  @db.VarChar(200)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  lastSeenAt DateTime @default(now())
  isTrusted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_sessions")
}

model ConsentRecord {
  id            String      @id @default(uuid())
  userId        String
  consentType   ConsentType
  consentedAt   DateTime    @default(now())
  ipAddress     String?     @db.VarChar(45)
  policyVersion String      @db.VarChar(500) @default("1.0")
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@map("consent_records")
}

model Complaint {
  id             String            @id @default(uuid())
  societyId      String
  raisedById     String
  flatNumber     String            @db.VarChar(500)
  category       String            @db.VarChar(50)
  priority       ComplaintPriority @default(medium)
  title          String            @db.VarChar(300)
  description    String?
  photos         String[]
  voiceNoteUrl   String?
  status         ComplaintStatus   @default(open)
  assignedToId   String?
  resolutionNote String?
  rating         Int?
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  society    Society  @relation(fields: [societyId], references: [id])
  raisedBy   User     @relation("ComplaintRaisedBy", fields: [raisedById], references: [id])
  assignedTo User?    @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id])

  @@index([societyId, status])
  @@index([societyId, flatNumber])
  @@map("complaints")
}

model MaintenanceBill {
  id          String     @id @default(uuid())
  societyId   String
  flatNumber  String     @db.VarChar(500)
  billMonth   DateTime
  amount      Decimal    @db.Decimal(10, 2)
  lateFee     Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount Decimal    @db.Decimal(10, 2)
  dueDate     DateTime
  status      BillStatus @default(unpaid)
  notes       String?
  createdAt   DateTime   @default(now())

  society  Society   @relation(fields: [societyId], references: [id])
  payments Payment[]

  @@unique([societyId, flatNumber, billMonth])
  @@index([societyId, billMonth])
  @@index([societyId, flatNumber, status])
  @@map("maintenance_bills")
}

model Payment {
  id            String        @id @default(uuid())
  billId        String?
  userId        String
  societyId     String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String        @db.VarChar(30)
  transactionId String?       @db.VarChar(100)
  receiptUrl    String?
  status        PaymentStatus @default(pending)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  bill    MaintenanceBill? @relation(fields: [billId], references: [id])
  user    User             @relation(fields: [userId], references: [id])
  society Society          @relation(fields: [societyId], references: [id])

  @@index([userId, createdAt])
  @@map("payments")
}

model Visitor {
  id            String         @id @default(uuid())
  societyId     String
  flatNumber    String         @db.VarChar(500)
  visitorName   String         @db.VarChar(200)
  visitorPhone  String?        @db.VarChar(500)
  visitorPhoto  String?
  purpose       VisitorPurpose
  companyName   String?        @db.VarChar(100)
  status        VisitorStatus  @default(pending)
  approvedById  String?
  guardId       String?
  entryTime     DateTime?
  exitTime      DateTime?
  createdAt     DateTime       @default(now())

  society    Society @relation(fields: [societyId], references: [id])
  approvedBy User?   @relation("VisitorApprovedBy", fields: [approvedById], references: [id])
  guard      User?   @relation("VisitorGuard", fields: [guardId], references: [id])

  @@index([societyId, createdAt])
  @@index([societyId, flatNumber, status])
  @@map("visitors")
}

model PreApproval {
  id           String   @id @default(uuid())
  societyId    String
  userId       String
  flatNumber   String   @db.VarChar(500)
  visitorName  String   @db.VarChar(200)
  visitorPhone String?  @db.VarChar(500)
  schedule     Json?
  validFrom    DateTime
  validUntil   DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("pre_approvals")
}

model Announcement {
  id          String               @id @default(uuid())
  societyId   String
  postedById  String
  title       String               @db.VarChar(300)
  body        String
  category    AnnouncementCategory @default(general)
  priority    AnnouncementPriority @default(normal)
  attachments String[]
  isPinned    Boolean              @default(false)
  createdAt   DateTime             @default(now())

  society   Society            @relation(fields: [societyId], references: [id])
  postedBy  User               @relation(fields: [postedById], references: [id])
  reads     AnnouncementRead[]

  @@index([societyId, createdAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

// ─── Marketplace ─────────────────────────────────────────────────────────────

model MarketplaceListing {
  id          String          @id @default(uuid())
  societyId   String
  userId      String
  title       String          @db.VarChar(200)
  description String?
  price       Decimal?        @db.Decimal(10, 2)
  isGiveaway  Boolean         @default(false)
  category    ListingCategory @default(other)
  photos      String[]
  status      ListingStatus   @default(available)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  society   Society           @relation(fields: [societyId], references: [id])
  seller    User              @relation(fields: [userId], references: [id])
  interests ListingInterest[]

  @@index([societyId, status])
  @@index([societyId, category])
  @@map("marketplace_listings")
}

model ListingInterest {
  id        String   @id @default(uuid())
  listingId String
  userId    String
  message   String?
  createdAt DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id])

  @@unique([listingId, userId])
  @@map("listing_interests")
}

// ─── Amenities ───────────────────────────────────────────────────────────────

model Amenity {
  id                String   @id @default(uuid())
  societyId         String
  name              String   @db.VarChar(100)
  description       String?
  photoUrl          String?
  maxCapacity       Int      @default(1)
  openTime          String   @db.VarChar(5)  // "06:00"
  closeTime         String   @db.VarChar(5)  // "22:00"
  slotDurationMins  Int      @default(60)
  bookingAdvanceDays Int     @default(7)
  depositAmount     Decimal? @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  society  Society          @relation(fields: [societyId], references: [id])
  bookings AmenityBooking[]

  @@index([societyId, isActive])
  @@map("amenities")
}

model AmenityBooking {
  id         String        @id @default(uuid())
  amenityId  String
  userId     String
  societyId  String
  bookDate   DateTime      @db.Date
  startTime  String        @db.VarChar(5)  // "10:00"
  endTime    String        @db.VarChar(5)  // "11:00"
  guests     Int           @default(1)
  notes      String?
  status     BookingStatus @default(confirmed)
  cancelledAt DateTime?
  createdAt  DateTime      @default(now())

  amenity Amenity @relation(fields: [amenityId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([amenityId, bookDate])
  @@index([userId, bookDate])
  @@map("amenity_bookings")
}

// ─── Emergency SOS ───────────────────────────────────────────────────────────

model SosAlert {
  id           String    @id @default(uuid())
  societyId    String
  userId       String
  flatNumber   String    @db.VarChar(500)
  message      String?   @db.VarChar(500)
  status       SosStatus @default(active)
  respondedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  society     Society @relation(fields: [societyId], references: [id])
  raisedBy    User    @relation("SosRaisedBy", fields: [userId], references: [id])
  respondedBy User?   @relation("SosRespondedBy", fields: [respondedById], references: [id])

  @@index([societyId, status])
  @@map("sos_alerts")
}

// ─── Expense Transparency ────────────────────────────────────────────────────

model ExpenseCategory {
  id           String   @id @default(uuid())
  societyId    String
  name         String   @db.VarChar(100)
  color        String   @db.VarChar(7)   // "#FF5733"
  budgetAmount Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  society  Society   @relation(fields: [societyId], references: [id])
  expenses Expense[]

  @@unique([societyId, name])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(uuid())
  societyId   String
  categoryId  String
  amount      Decimal  @db.Decimal(10, 2)
  description String   @db.VarChar(500)
  receiptUrl  String?
  expenseMonth DateTime // First day of month
  createdById String
  createdAt   DateTime @default(now())

  society   Society         @relation(fields: [societyId], references: [id])
  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])

  @@index([societyId, expenseMonth])
  @@map("expenses")
}

// ─── AI: Knowledge base (Phase 2 — committee-filled FAQ, RAG-ready) ───────────

model KnowledgeEntry {
  id          String   @id @default(uuid())
  societyId   String
  topic       String   @db.VarChar(200)
  question    String   @db.VarChar(500)
  answer      String
  keywords    String[]
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society   Society @relation(fields: [societyId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([societyId])
  @@map("knowledge_entries")
}

// ─── AI: Smart Agreements (Phase 3 — LLM-generated documents) ─────────────────

enum AgreementType {
  rent
  lease
  leave_license
}

enum AgreementStatus {
  draft
  finalized
}

model Agreement {
  id          String          @id @default(uuid())
  societyId   String
  createdById String
  type        AgreementType
  status      AgreementStatus @default(draft)
  flatNumber  String          @db.VarChar(500)
  inputs      Json
  content     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  society   Society @relation(fields: [societyId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([societyId])
  @@map("agreements")
}

// ─── Security Audit Log (Phase 4) ────────────────────────────────────────────
// Append-only — a DB trigger prevents UPDATE and DELETE on this table.
// See migration: 20260630_phase4_security_audit

model SecurityAuditLog {
  id         String   @id @default(uuid())
  userId     String?
  societyId  String?
  action     String   @db.VarChar(100)
  resource   String?  @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  country    String?  @db.VarChar(50)
  success    Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([societyId, createdAt])
  @@index([action, createdAt])
  @@map("security_audit_logs")
}
